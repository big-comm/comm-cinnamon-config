#!/bin/sh

# Replace Exec= in X11 session .desktop files
# Use full line replacement (^Exec=.*) to avoid prefix matching issues
# Upstream uses Exec=cinnamon-session-cinnamon (wrapper), not Exec=cinnamon-session
sed -i 's|^Exec=.*|Exec=/usr/bin/startcinnamon-community --session cinnamon|' /usr/share/xsessions/cinnamon.desktop 2>/dev/null
sed -i 's|^Exec=.*|Exec=/usr/bin/startcinnamon-community --session cinnamon2d|' /usr/share/xsessions/cinnamon2d.desktop 2>/dev/null

# Replace Exec= in Wayland session .desktop file
sed -i 's|^Exec=.*|Exec=/usr/bin/startcinnamon-community --session cinnamon-wayland|' /usr/share/wayland-sessions/cinnamon-wayland.desktop 2>/dev/null

# Restore the systemd defaults we used to relax here.
#
# The old values (DefaultRestartSec=1000ms, DefaultStartLimitBurst=10) were meant to
# avoid a race with session startup scripts, JamesDSP autostart in particular, but
# they disabled the restart rate limit for every user service on the system:
# 10 restarts at 1s apiece span ~12.5s, which never fits the 10s window, so a service
# that keeps failing restarts forever instead of being stopped. That is what turned
# the JamesDSP autostart conflict into a loop of tens of thousands of restarts.
# The conflict itself is fixed at the source, by dropping the duplicate unit.
sed -i 's|^DefaultRestartSec=1000ms|#DefaultRestartSec=100ms|;s|^DefaultStartLimitBurst=10|#DefaultStartLimitBurst=5|' /etc/systemd/user.conf 2>/dev/null
