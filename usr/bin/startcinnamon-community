#!/bin/bash

# Defining the default visual style to be used in applications that use Qt
[[ -z $QT_STYLE_OVERRIDE ]] && export QT_STYLE_OVERRIDE="kvantum"
[[ -z $QT_QPA_PLATFORMTHEME ]] && export QT_QPA_PLATFORMTHEME="xdg-desktop-portal"
[[ -z $QT_WAYLAND_DECORATION ]] && export QT_WAYLAND_DECORATION="adwaita"

# Apps in electron use wayland
[[ -z $ELECTRON_OZONE_PLATFORM_HINT ]] && export ELECTRON_OZONE_PLATFORM_HINT="auto"

# Cinnamon must own the session environment before theme sync runs.
export DESKTOP_SESSION=cinnamon
export XDG_SESSION_DESKTOP=cinnamon
export XDG_CURRENT_DESKTOP=X-Cinnamon
export GDMSESSION=cinnamon
unset ADW_DEBUG_COLOR_SCHEME

# Force software GTK renderer in VMs/mesa-amber sessions with broken Vulkan.
if compgen -G /var/lib/pacman/local/mesa-amber-* >/dev/null || systemd-detect-virt -q; then
    [[ -z $GSK_RENDERER ]] && export GSK_RENDERER="cairo"
fi

start_graphical_session_bridge() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user import-environment \
            DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP DESKTOP_SESSION XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
            2>/dev/null || true
        systemctl --user start biglinux-graphical-session.target 2>/dev/null || true
    fi
}

sync_theme_to_qt() {
    if [ -f "/usr/share/sync-kde-and-gtk-places/sync-gnome-theme-to-qt.sh" ]; then
        for i in {1..3}; do
            if /usr/share/sync-kde-and-gtk-places/sync-gnome-theme-to-qt.sh; then
                logger "sync-gnome-theme-to-qt.sh executed successfully"
                return 0
            else
                logger "Failed to execute sync-gnome-theme-to-qt.sh, attempt $i"
                sleep 0.5
            fi
        done
    else
        logger "sync-gnome-theme-to-qt.sh not found"
    fi

    return 1
}

get_live_theme_mode() {
    [[ -f /tmp/big_desktop_theme ]] || return 1

    case "$(< /tmp/big_desktop_theme)" in
        light|dark)
            cat /tmp/big_desktop_theme
            ;;
        *)
            return 1
            ;;
    esac
}

apply_cinnamon_theme_mode() {
    local mode="$1"
    local color_scheme gtk_theme icon_theme cinnamon_theme prefer_dark

    if [[ "$mode" == "dark" ]]; then
        color_scheme="prefer-dark"
        gtk_theme="adw-gtk3-dark"
        icon_theme="bigicons-papient-dark"
        cinnamon_theme="Big-Orange"
        prefer_dark="true"
    else
        color_scheme="default"
        gtk_theme="adw-gtk3"
        icon_theme="bigicons-papient"
        cinnamon_theme="Big-Orange-Light"
        prefer_dark="false"
    fi

    dconf write /org/gnome/desktop/interface/color-scheme "'$color_scheme'" 2>/dev/null || true
    dconf write /org/gnome/desktop/interface/gtk-theme "'$gtk_theme'" 2>/dev/null || true
    dconf write /org/gnome/desktop/interface/icon-theme "'$icon_theme'" 2>/dev/null || true
    dconf write /org/cinnamon/desktop/interface/gtk-theme "'$gtk_theme'" 2>/dev/null || true
    dconf write /org/cinnamon/desktop/interface/icon-theme "'$icon_theme'" 2>/dev/null || true
    dconf write /org/cinnamon/theme/name "'$cinnamon_theme'" 2>/dev/null || true

    mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
    for gtk_settings in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
        touch "$gtk_settings"
        grep -q '^\[Settings\]' "$gtk_settings" || sed -i '1i[Settings]' "$gtk_settings"
        for key in gtk-theme-name gtk-icon-theme-name gtk-application-prefer-dark-theme; do
            sed -i "/^${key}=/d" "$gtk_settings"
        done
        sed -i "/^\[Settings\]/a gtk-application-prefer-dark-theme=${prefer_dark}" "$gtk_settings"
        sed -i "/^\[Settings\]/a gtk-icon-theme-name=${icon_theme}" "$gtk_settings"
        sed -i "/^\[Settings\]/a gtk-theme-name=${gtk_theme}" "$gtk_settings"
    done

    export ADW_DEBUG_COLOR_SCHEME="$color_scheme"
    dbus-update-activation-environment --systemd ADW_DEBUG_COLOR_SCHEME 2>/dev/null || true
    systemctl --user import-environment ADW_DEBUG_COLOR_SCHEME 2>/dev/null || true
}

apply_live_theme_mode() {
    local mode

    mode="$(get_live_theme_mode)" || return 0
    log_message "Applying live Cinnamon theme mode: $mode"
    apply_cinnamon_theme_mode "$mode"
}

settle_live_theme_and_start_sync() {
    (
        for delay in 2 4 6; do
            sleep "$delay"
            apply_live_theme_mode
            sync_theme_to_qt
        done

        start_sync_services
    ) &
}

start_graphical_session_bridge

# Force language
if [ "$LANGUAGE" = "" ]; then
    [[ -z $LANGUAGE ]] && export LANGUAGE=$LANG
fi

# Checks if the shell has already been changed
if [ ! -f "$HOME/.biglinux-shell-changed" ]; then
    biglinux-change-default-shell bash-power
    touch "$HOME/.biglinux-shell-changed"
fi

# Faster AMD GPU


# OBS Studio game capture with vulkan
if [ -e "/usr/bin/obs-vkcapture" ]; then
    [[ -z $OBS_USE_EGL ]] && export OBS_USE_EGL=1
    [[ -z $OBS_VKCAPTURE ]] && export OBS_VKCAPTURE=1
    [[ -z $VK_INSTANCE_LAYERS ]] && export VK_INSTANCE_LAYERS="VK_LAYER_OBS_vkcapture_64:VK_LAYER_VALVE_steam_overlay_64" #Fix MangoHUD overlay
fi

# Keyboard LED
if [ -e "$HOME/.config/ledkeyboard" ]; then
   change-keyboard-led on
fi

# Define the correct dconf path based on desktop environment
if [[ "$XDG_SESSION_DESKTOP" = "cinnamon" ]]; then
    dconfPath=/org/cinnamon/desktop/interface/cursor-theme
else
    dconfPath=/org/gnome/desktop/interface/cursor-theme
fi

# Get the current cursor theme
currentTheme=$(dconf read $dconfPath)

# Check if the current theme is 'Breeze_Light'
if [ "$currentTheme" == "'Breeze_Light'" ]; then
    # Change the cursor theme to 'Bibata-Modern-Classic'
    dconf write $dconfPath "'Bibata-Modern-Classic'"
fi

# Enable automatic mounting of devices
gsettings set org.gnome.desktop.media-handling automount true

# Configure first boot settings (theme, JamesDSP)
# Applies user's choices from live session to the installed system
#-------------------------------------------------------------------------------
themeFile="/etc/big-default-config/theme"
if [[ -e "$themeFile" && ! -e "$HOME/.big_desktop_theme" ]]; then
    settings_file="$HOME/.config/dconf/settings.cinnamon"
    theme="$(<"$themeFile")"

    # Apply light theme if selected (skel defaults to dark)
    if [[ "$theme" == "light" && -e "$settings_file" ]]; then
        logger "Applying light theme on first boot"
        sed -i "s|color-scheme='prefer-dark'|color-scheme='default'|g" "$settings_file"
        sed -i "s|gtk-theme='adw-gtk3-dark'|gtk-theme='adw-gtk3'|g" "$settings_file"
        sed -i "s|icon-theme='bigicons-papient-dark'|icon-theme='bigicons-papient'|g" "$settings_file"
        sed -i "/^\[org\/cinnamon\/theme\]/,/^\[/ s|name='Big-Orange'|name='Big-Orange-Light'|" "$settings_file"
    fi

    # JamesDSP configuration
    jamesdsp_conf="$HOME/.config/jamesdsp/application.conf"
    if [[ -e "$jamesdsp_conf" ]]; then
        if [[ -e /etc/big-default-config/jamesdsp ]]; then
            sed -i "s|AutoStartEnabled=false|AutoStartEnabled=true|g" "$jamesdsp_conf"
            systemctl --user restart jamesdsp-autostart.service 2>/dev/null
            logger "JamesDSP autostart enabled on first boot"
        else
            sed -i "s|AutoStartEnabled=true|AutoStartEnabled=false|g" "$jamesdsp_conf"
            systemctl --user stop jamesdsp-autostart.service 2>/dev/null
            logger "JamesDSP autostart disabled on first boot"
        fi
    fi

    touch "$HOME/.big_desktop_theme"
fi

if [[ -e "$HOME/.first-boot" ]]; then
    rm -f "$HOME/.first-boot"
    logger "First boot configuration completed"
fi

#-------------------------------------------------------------------------------
# # --- START Configuration dconf and mimeapps
#-------------------------------------------------------------------------------
# Base directories for configurations
dconf_dir="$HOME/.config/dconf"
mimeapps_dir="$HOME/.config"
log_file="/tmp/dconf-switch-cinnamon.log"

# Function to log messages
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [CINNAMON] $1" | tee -a "$log_file"
}

# Function to load mimeapps configuration
load_mimeapps_config() {
    log_message "Loading Cinnamon mimeapps configuration"

    # Load specific mimeapps configuration
    if [ -f "$mimeapps_dir/cinnamon.mimeapps.list" ]; then
        log_message "Found existing Cinnamon mimeapps, loading..."
        cp "$mimeapps_dir/cinnamon.mimeapps.list" "$mimeapps_dir/mimeapps.list"
    else
        log_message "No existing Cinnamon mimeapps found, creating empty file"
        touch "$mimeapps_dir/mimeapps.list"
    fi
}

# Function to load dconf configuration
load_dconf_config() {
    # Ensure directory exists
    mkdir -p "$dconf_dir"

    log_message "Loading Cinnamon dconf configuration"
    log_message "XDG_CURRENT_DESKTOP: $XDG_CURRENT_DESKTOP"
    log_message "Stopping theme and dconf sync temporarily..."
    local skip_save_file="${XDG_RUNTIME_DIR:-/tmp}/dconf-sync-cinnamon.skip-save"
    touch "$skip_save_file" 2>/dev/null || true
    systemctl --user stop dconf-sync-cinnamon.service 2>/dev/null || true
    rm -f "$skip_save_file" 2>/dev/null || true
    systemctl --user stop sync-gnome-theme-to-qt.service 2>/dev/null || true
    systemctl --user stop sync-gnome-theme-to-qt.path 2>/dev/null || true

    # Load configuration for Cinnamon
    local settings_file="$dconf_dir/settings.cinnamon"
    local backup_file="$dconf_dir/settings.cinnamon.bak"

    # Restore from backup if settings file is empty or missing (forced shutdown protection)
    if [[ -f "$settings_file" && ! -s "$settings_file" && -s "$backup_file" ]]; then
        log_message "WARNING: settings.cinnamon is empty, restoring from backup"
        cp -f "$backup_file" "$settings_file"
        log_message "Backup restored successfully"
    fi

    if [[ -s "$settings_file" ]]; then
        log_message "Found existing Cinnamon settings, loading..."
        log_message "Resetting dconf database"
        dconf reset -f /

        log_message "Loading settings from: $settings_file"
        if dconf load / < "$settings_file"; then
            log_message "Cinnamon settings loaded successfully"
        else
            log_message "ERROR: Failed to load Cinnamon settings"
            # Try backup if main file failed to load
            if [[ -s "$backup_file" ]]; then
                log_message "Attempting to load from backup..."
                if dconf load / < "$backup_file"; then
                    log_message "Backup settings loaded successfully"
                    cp -f "$backup_file" "$settings_file"
                fi
            fi
        fi
    else
        log_message "No existing Cinnamon settings found - will create on first save"
    fi

    apply_live_theme_mode
}

# Function to start systemd sync services
start_sync_services() {
    log_message "Starting sync services..."

    # Start dconf sync service
    log_message "Starting dconf-sync-cinnamon.service"
    if systemctl --user enable dconf-sync-cinnamon.service 2>/dev/null; then
        log_message "dconf-sync service enabled"
    fi
    if systemctl --user restart dconf-sync-cinnamon.service 2>/dev/null; then
        log_message "dconf-sync service started successfully"
    else
        log_message "WARNING: Failed to start dconf-sync service"
    fi

    # Start mimeapps sync service
    log_message "Starting mimeapps-sync-cinnamon.service"
    if systemctl --user enable mimeapps-sync-cinnamon.service 2>/dev/null; then
        log_message "mimeapps-sync service enabled"
    fi
    if systemctl --user restart mimeapps-sync-cinnamon.service 2>/dev/null; then
        log_message "mimeapps-sync service started successfully"
    else
        log_message "WARNING: Failed to start mimeapps-sync service"
    fi

    # Start GTK/Qt theme sync path after the initial dconf load has settled.
    log_message "Starting sync-gnome-theme-to-qt.path"
    if systemctl --user start sync-gnome-theme-to-qt.path 2>/dev/null; then
        log_message "theme sync path started successfully"
    else
        log_message "WARNING: Failed to start theme sync path"
    fi
}

# Main execution
log_message "=========================================="
log_message "Starting Cinnamon session configuration"
log_message "=========================================="

# Load configurations
load_mimeapps_config
load_dconf_config

sync_theme_to_qt

if [ -e /usr/bin/startbiglive ]; then
    settle_live_theme_and_start_sync
else
    start_sync_services
fi

log_message "Cinnamon session configuration completed"
# --- END Configuration dconf and mimeapps


#-------------------------------------------------------------------------------
# ### Execute in LiveCD
#-------------------------------------------------------------------------------
if [ -e /usr/bin/startbiglive ]; then
    # Ensure Cinnamon session variables in live mode.
    export DESKTOP_SESSION=cinnamon
    export XDG_SESSION_DESKTOP=cinnamon
    export XDG_CURRENT_DESKTOP=X-Cinnamon
    export GDMSESSION=cinnamon
    unset ADW_DEBUG_COLOR_SCHEME

    # Enables basic, unencrypted password storage in Chromium-based browsers
    sudo sed -i '/--password-store=basic/!s/\(exec \/usr\/lib\/brave-browser\/brave "$@" $USER_FLAGS\)$/\1 --password-store=basic/' /usr/bin/brave

    # Updates user directories
    LANG=$LANG xdg-user-dirs-update --force
    
    # Disable the lock screen and screensaver
    gsettings set org.cinnamon.desktop.screensaver lock-enabled false
    gsettings set org.cinnamon.desktop.screensaver idle-activation-enabled false
fi

# Execute cinnamon-session, passing through any arguments (e.g., --session cinnamon-wayland)
exec /usr/bin/cinnamon-session "$@"
